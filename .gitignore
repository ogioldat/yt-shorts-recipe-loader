# Installed MCP server code. package.json pins the exact upstream commit and
# package-lock.json pins its whole tree, so the install is reproducible without
# committing 132 third-party packages.
mcp/**/node_modules/

# Credentials — never commit
.env
*.env

# SQLite's transient sidecars. state/library.db itself IS committed: it is the
# library, and the only copy. Checkpoint the WAL before committing so the .db
# holds everything:
#   uv run python -c "import sqlite3; sqlite3.connect('state/library.db').execute('PRAGMA wal_checkpoint(TRUNCATE)')"
state/library.db-wal
state/library.db-shm

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.DS_Store

# Editor-local
.vscode/
.idea/

docs/superpowers/**