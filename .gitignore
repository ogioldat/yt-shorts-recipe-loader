# Installed MCP server code. package.json pins the exact upstream commit and
# package-lock.json pins its whole tree, so the install is reproducible without
# committing 132 third-party packages.
mcp/**/node_modules/

# Credentials — never commit
.env
*.env

# yt-dlp full metadata dumps (~620KB each). Only pruned meta.json is kept.
raw/**/*.info.json

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.DS_Store

# Editor-local
.vscode/

docs/superpowers/**